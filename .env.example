# --- Base de datos (Supabase) -------------------------------------------------
# DATABASE_URL: pooler transaccional (puerto 6543). La usa la app en runtime.
#   Es compatible con Railway y evita agotar las conexiones de Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# DIRECT_URL: pooler de sesion (puerto 5432). Lo usa `prisma migrate deploy`.
#   En Railway conviene copiar el Session pooler de Supabase para evitar
#   depender de IPv6 del endpoint directo.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Genera uno nuevo por entorno con: openssl rand -base64 32
# NUNCA reutilices este valor de ejemplo: firma las cookies de sesion.
AUTH_SECRET=""

# URL publica de la app (usa la URL generada por Railway en produccion)
AUTH_URL="http://localhost:3000"

# Opcional: ruta persistente para imagenes. En Railway usa un Volume montado
# exactamente en /app/public/uploads y define UPLOAD_DIR con ese mismo valor.
# UPLOAD_DIR="/app/public/uploads"

# --- Seed ---------------------------------------------------------------------
# Contrasena del usuario propietario que crea `npm run db:seed`.
# El seed falla si esta vacia: no existe contrasena por defecto.
SEED_OWNER_PASSWORD=""
