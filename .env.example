# --- Base de datos (Supabase) -------------------------------------------------
# DATABASE_URL: conexion agrupada (pooler, puerto 6543). La usa la app en runtime.
#   En Vercel/serverless es obligatorio el pooler: cada invocacion abre su propia
#   conexion y la base se queda sin slots si se apunta al puerto directo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# DIRECT_URL: conexion directa (puerto 5432). La usa `prisma migrate`, que no
#   puede trabajar a traves de pgbouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Genera uno nuevo por entorno con: openssl rand -base64 32
# NUNCA reutilices este valor de ejemplo: firma las cookies de sesion.
AUTH_SECRET=""

# URL publica de la app (en Vercel se infiere sola; definela en local y en dominios propios)
AUTH_URL="http://localhost:3000"

# --- Seed ---------------------------------------------------------------------
# Contrasena del usuario propietario que crea `npm run db:seed`.
# El seed falla si esta vacia: no existe contrasena por defecto.
SEED_OWNER_PASSWORD=""
